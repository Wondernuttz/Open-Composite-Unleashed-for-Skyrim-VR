.label "F10"

key \f11 \f11 12.181 0.058 1.045 0.935
.label "F11"

key \f12 \f12 13.2 0.1 1.194 0.922
.label "F12"

key ` ~ 0 1 1 1
.label "`"
.label_shift "~"

key 1 ! 1 1 1 1
.label "1"
.label_shift "!"

key 2 @ 2 1 1 1
.label "2"
.label_shift "@"

key 3 # 3 1 1 1
.label "3"
.label_shift "#"

key 4 $ 4 1 1 1
.label "4"
.label_shift "$"

key 5 % 5.069 1.023 0.922 0.974
.label "5"
.label_shift "%"

key 6 ^ 6.046 1.012 0.948 0.987
.label "6"
.label_shift "^"

key 7 & 7.058 1.023 0.935 0.974
.label "7"
.label_shift "&"

key 8 * 8.081 1.012 0.908 0.987
.label "8"
.label_shift "*"

key 9 ( 9.058 1.012 0.935 0.987
.label "9"
.label_shift "("

key 0 ) 10.046 1.012 0.948 0.987
.label "0"
.label_shift ")"

key - _ 11.046 1.023 0.948 0.974
.label "-"
.label_shift "_"

key = + 12.035 1.046 0.961 0.948
.label "="
.label_shift "+"

key \b \b 13.127 1.035 2.427 0.961
.label "back"
.label_scale 0.85

key \t \t 0 2.068 1.602 0.923
.label "tab"
.label_offset 3 1

