# OCU Keyboard Studio custom keyboard
# Label offsets are pixels in OCU's 1024x560 keyboard texture.

width 15
base_theme dwemer
font parchment
key_plates true
top_button_plates true
input_bar_plate true
parchment_ribbon true

style custom
font_color #65F8FFFF
font_outline_color #080B0FDC
font_glow_color #BEFAFFFF
font_glow_enabled true
font_glow_strength 10
font_glow_radius 6
font_breathe true 0 1.5 0
key_color #BE8C465A
plate_fill_color #FFFFFF00
plate_outline_width 0
glow_color #EFFFB4FF
hover_color #FFFFFFFF
glow_enabled true
glow_strength 65
glow_radius 8
hover_enabled true
hover_strength 45
label_outline true
key_roundness 2
key_breathe true 35 2 90

control_offset size -1 28
control_offset opacity 5.071 27.894
control_offset tilt 4 55
top_offset textbar 0 0
top_offset mode -1 -9
top_offset lock 18 -3
top_design textbar 616.267 45 0
top_design mode 134.063 32 0
top_design lock 117.658 32 0
control_box size 92 98
control_part size up 0 0 24 20
control_part size down 0 0 24 20
control_text size label 0 0 0.58
control_text size value 0 4.142 0.58
control_box opacity 89.929 101.106
control_part opacity up 0 -15.531 24 20
control_part opacity down 0 0 24 20
control_text opacity label 1.035 -4.142 0.58
control_text opacity value 1.035 4.142 0.58
control_box tilt 92 98
control_part tilt up 0 0 24 20
control_part tilt down 0 0 24 20
control_text tilt label 0 0 0.58
control_text tilt value 0 7.248 0.58

key \e \e 0 0.046 1.605 0.948
.label "ESC"

key \f1 \f1 1.546 0.058 0.998 0.935
.label "F1"

key \f2 \f2 2.585 0.058 1.011 0.935
.label "F2"

key \f3 \f3 3.635 0.058 1.011 0.935
.label "F3"

key \f4 \f4 4.704 0.058 0.985 0.935
.label "F4"

key \f5 \f5 5.735 0.046 1.011 0.948
.label "F5"

key \f6 \f6 6.781 0.058 0.958 0.935
.label "F6"

key \f7 \f7 7.823 0.069 1.024 0.922
.label "F7"

key \f8 \f8 8.85 0.058 1.05 0.935
.label "F8"

