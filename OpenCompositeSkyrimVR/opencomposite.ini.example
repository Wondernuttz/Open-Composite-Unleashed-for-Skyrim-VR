; ============================================================================
;  OpenComposite Configuration — Skyrim VR
; ============================================================================
;
;  Place this file as "opencomposite.ini" in one of two locations:
;    1. Next to the openvr_api.dll (global — applies to all games using this DLL)
;    2. In the game's working directory (per-game — overrides global settings)
;
;  You can also use "opencomposite_ext.ini" in the working directory for
;  additional overrides on top of both files above.
;
;  All settings are optional. If a line is commented out (starts with ;)
;  the default value shown will be used automatically.
;
;  Boolean values: true / on / enabled  or  false / off / disabled
;  Colours: #RRGGBB hex format (like CSS)
;
; ============================================================================


; ----------------------------------------------------------------------------
;  GENERAL / RENDERING
; ----------------------------------------------------------------------------

; Supersampling multiplier applied to the render resolution.
; 1.0 = native,  1.5 = 150%,  0.8 = 80%.  Higher = sharper but heavier on GPU.
; Runtime range: 0.5-2.0. Values above 2.0 are clamped to prevent oversized VR render targets.
; Default: 1.0
;supersampleRatio=1.0

; Correct texture MIP selection when DLSS/FSR3 renders below display resolution.
; Default: true
;mipBiasEnabled=true

; MIP LOD bias mode.
; auto uses log2(renderScale) plus mipBiasOffset.
; You can also set a fixed numeric value, e.g. mipBias=-0.766.
; Default: auto
;mipBias=auto

; Extra offset used only when mipBias=auto.
; Default: 0.0
;mipBiasOffset=0.0

; Additional DLSS-only offset used only when mipBias=auto.
; Default: 0.0
;dlssMipBiasOffset=0.0

; Additional FSR3-only offset used only when mipBias=auto.
; Default: 1.0
;fsr3MipBiasOffset=1.0

; FIXED foveated rendering for headsets without eye tracking. This keeps the
; legacy key name for compatibility. It never changes CSX render scale,
; swapchain dimensions, ASW depth, or motion vectors.
; Default: false
;vrsEnabled=false

; EYE TRACKING / AUTO. Uses XR_EXT_eye_gaze_interaction only when the active
; runtime and headset provide a valid fresh gaze pose. If gaze is unavailable,
; VRS stays off unless FIXED above was also explicitly enabled. CSX/game menus
; are always full-rate.
; Default: true
;vrsEyeTracked=true

; Foveated-rendering backend: auto, vrs, or rdm. Auto prefers NVIDIA's
; hardware VRS when available and otherwise uses the cross-vendor D3D11
; Radial Density Mask backend (AMD/Intel/NVIDIA). Default: auto
;foveatedBackend=auto

; Fixed-mode compatibility cap. Caps coarse shading at half-rate (2x1/1x2).
; Existing eye profiles without their own explicit cap inherit this setting.
; Default: true
;vrsCompatibilityMode=true

; Moving-eye Performance profile (fresh-install and full-reset default):
; Center 0.20 / Middle 0.40, rates 1x1 / 2x2 / 4x2, eye half-rate cap off.
; Older saved profiles keep their explicit values; missing rate keys in an
; existing profile retain the former 1x1 / 2x1 / 2x2 fallbacks. To select the
; complete current Performance in an existing INI, set all seven options below.
;vrsEyeInnerRadius=0.20
;vrsEyeMidRadius=0.40
;vrsEyeCustomRates=true
;vrsEyeCompatibilityMode=false
;vrsEyeInnerRate=1x1
;vrsEyeMidRate=2x2
;vrsEyeOuterRate=4x2
; Other eye presets (all use custom rates and eye half-rate cap off):
; Quality:    0.30 / 0.65, rates 1x1 / 1x2 / 2x2
; Balanced:   0.22 / 0.45, rates 1x1 / 2x2 / 4x2
; Aggressive: 0.20 / 0.40, rates 1x1 / 2x2 / 4x4

; Fixed-mode radii are independent of the moving-eye profile.
; Defaults: 0.70 / 0.85. The compatibility cap above still applies.
;vrsFixedInnerRadius=0.70
;vrsFixedMidRadius=0.85

; Legacy vrsInnerRadius / vrsMidRadius values, if explicitly present, supply
; missing radii for both modes. Use the separate fixed/eye keys for new tuning.

; Overlay gaze/foveation ring diagnostics in game. Default: false
;foveationDebugRings=false

; Choose whether half-rate tiles use 2x1 (true) or 1x2 (false).
; Default: true
;vrsFavorHorizontal=true

; Render the default OpenComposite controller models.
; Set to false if you prefer in-game hand models or use a mod like VRIK.
; Default: true
;renderCustomHands=true

; Use OCU's original grey hand meshes instead of installed SteamVR controller models.
; This does not turn hand rendering on or off; renderCustomHands remains the master switch.
; Default: false
;useLegacyGreyHands=false

; Colour of the rendered controller models (hex #RRGGBB).
; Only matters when renderCustomHands is true.
; Default: #4D4D4D  (dark grey)
;handColour=#4D4D4D

; Preserve the player's current left/right hand profile, bindings, and model
; while a controller sleeps or wakes instead of replacing it with a Vive wand.
; This does not prevent the physical controller from entering power saving.
; Default: true
;preserveControllerProfileOnSleep=true

; Enable controller haptic feedback (vibration).
; Default: true
;haptics=true

; Strength of haptic feedback. Range 0.0 to 1.0.
; Default: 0.1
;hapticStrength=0.1

; Enable the OpenXR composition layer system (overlays, keyboard, etc.).
; Default: true
;enableLayers=true

; Use DX10 feature level instead of DX11.
; Only enable if you have compatibility issues with older hardware.
; Default: false
;dx10Mode=false

; Enable the hidden area mesh fix to reduce GPU load by skipping pixels
; outside the visible lens area.
; Default: true
;enableHiddenMeshFix=true

; Vertical scale factor for the hidden area mesh.
; Adjust if you see black bars at the top/bottom of the view.
; Default: 1.0
;hiddenMeshVerticalScale=1.0

; Invert the eye textures using shaders instead of a texture copy.
; May fix upside-down rendering in some games.
; Default: false
;invertUsingShaders=false

; Force OpenXR initialisation through Vulkan instead of DX11.
; Only needed on systems where DX11 is unavailable (e.g. Linux/Proton).
; Default: false
;initUsingVulkan=false

; Enable cubemap support when the application requests it.
; Default: true
;enableAppRequestedCubemap=true

; Use three-part texture submission (separate left/right/both passes).
; Default: true
;threePartSubmit=true

; Use the viewport stencil optimisation.
; Default: false
;useViewportStencil=false

; Report Touch controllers as connected even if the runtime doesn't.
; Useful for games that only check for specific controller types.
; Default: true
;forceConnectedTouch=true


; ----------------------------------------------------------------------------
;  AUDIO
; ----------------------------------------------------------------------------

; Automatically switch the Windows default audio device to match your headset
; when the game starts.
; Default: false
;enableAudioSwitch=false

; Name of the audio device to switch to (partial match is fine).
; Only used when enableAudioSwitch is true.
; Example: audioDeviceName=Rift Audio
; Default: (empty)
;audioDeviceName=


; ----------------------------------------------------------------------------
;  INPUT DROPOUT PROTECTION
; ----------------------------------------------------------------------------

; Retain the strongest recent controller input to bridge momentary runtime
; dropouts. This covers sticks, triggers, grips, buttons, and touch states.
; It does not average or smooth values; releases can linger for the window.
; Default: false
;enableInputSmoothing=false

; Number of recent input samples retained. 3-5 is a practical starting range.
; Higher values survive longer dropouts but add more release latency.
; Only used when enableInputSmoothing is true.
; Default: 5
;inputWindowSize=5


; ----------------------------------------------------------------------------
;  CONTROLLER POSITION/ROTATION ADJUSTMENTS
; ----------------------------------------------------------------------------

; Master switch for tilt adjustment.
; Default: false
;adjustTilt=false

; Tilt angle in degrees. Positive tilts controllers forward.
; Only used when adjustTilt is true.
; Default: 0.0
;tilt=0.0

; Master switches for per-hand rotation adjustments.
; Default: false
;adjustLeftRotation=false
;adjustRightRotation=false

; Rotation offsets in degrees for each axis (pitch, yaw, roll).
; Only used when the corresponding adjust*Rotation is true.
; Default: 0.0 for all
;leftXRotation=0.0
;leftYRotation=0.0
;leftZRotation=0.0
;rightXRotation=0.0
;rightYRotation=0.0
;rightZRotation=0.0

; Master switches for per-hand position adjustments.
; Default: false
;adjustLeftPosition=false
;adjustRightPosition=false

; Position offsets in metres for each axis.
; Only used when the corresponding adjust*Position is true.
; Default: 0.0 for all
;leftXPosition=0.0
;leftYPosition=0.0
;leftZPosition=0.0
;rightXPosition=0.0
;rightYPosition=0.0
;rightZPosition=0.0

; Laser aim calibration rotates the OpenXR aim pose used by the OCU keyboard,
; menu lasers, and the OC_AIM_POSES export consumed by Prisma UI.
; Use at your own risk and report useful headset/runtime/controller values to OCU devs.
; Default: false
;adjustLeftLaserRotation=false
;adjustRightLaserRotation=false

; Laser rotation offsets in degrees for each axis (pitch, yaw, roll).
; Only used when the corresponding adjust*LaserRotation is true.
; Default: 0.0 for all
;leftLaserXRotation=0.0
;leftLaserYRotation=0.0
;leftLaserZRotation=0.0
;rightLaserXRotation=0.0
;rightLaserYRotation=0.0
;rightLaserZRotation=0.0

; Smooth only OCU's rendered menu and keyboard rays. The calibrated raw
; OC_AIM_POSES export stays unsmoothed so Prisma UI can apply exactly one filter.
; Default: true
;enableLaserSmoothing=true

; Adaptive ray-filter tuning. Cutoffs are Hz at rest. Response adds cutoff Hz
; per metre/second for position and per radian/second for aim direction. Motion
; speed is low-pass filtered at 1 Hz so sensor noise cannot disable smoothing.
; Higher cutoff/response reacts faster; lower values smooth more but add lag.
;laserPosSmoothMinCutoff=6.0
;laserPosSmoothBeta=12.0
;laserRotSmoothMinCutoff=4.0
;laserRotSmoothBeta=0.35


; ----------------------------------------------------------------------------
;  DEAD ZONES  (thumbstick)
; ----------------------------------------------------------------------------

; Swap the physical thumbstick values and capacitive touch so the right stick
; drives locomotion and the left stick drives turning. Stick press/click and
; all other buttons stay on their original hands. Dead-zone settings still
; follow the physical controllers so drift is filtered correctly.
; Default: false
;swapThumbsticks=false

; Uniform dead zone radius. Set > 0 to ignore small stick movements.
; Default: 0.0
;leftDeadZoneSize=0.0
;rightDeadZoneSize=0.0

; Per-axis dead zones (override the uniform size if non-zero).
; Default: 0.0
;leftDeadZoneXSize=0.0
;leftDeadZoneYSize=0.0
;rightDeadZoneXSize=0.0
;rightDeadZoneYSize=0.0


; ----------------------------------------------------------------------------
;  CONTROLLER SMOOTHING  (1-Euro filter for hand tracking)
; ----------------------------------------------------------------------------

; Smooth controller position/rotation to reduce jitter.
; Useful for games that have shaky hand rendering.
; Default: true
;enableControllerSmoothing=true

; 1-Euro filter parameters. Lower minCutoff = more smoothing (but more lag).
; Higher beta = faster reaction to quick movements.
; Position defaults: minCutoff=1.25, beta=20
;posSmoothMinCutoff=1.25
;posSmoothBeta=20

; Rotation defaults: minCutoff=1.5, beta=0.2
;rotSmoothMinCutoff=1.5
;rotSmoothBeta=0.2


; ----------------------------------------------------------------------------
;  MISC
; ----------------------------------------------------------------------------

; Disable the trigger "touch" state (only report full press).
; Some games behave oddly with trigger touch events.
; Default: true
;disableTriggerTouch=true

; Disable the Quest/Oculus thumbrest capacitive touch binding.
; When enabled, thumbrest touch will not emit DPad_Up.
; Default: true
;disableThumbrestTouch=true

; Disable Skyrim's legacy upper/lower physical-trackpad click routing.
; This does not disable or emulate thumbsticks.
; Default: false
;disableTrackPad=false

; Use Index trackpad pressure for VRIK gestures (A-touch), instead of button bindings.
; VRIK installation alone does not require this. Off allows upper/lower assignments.
; Default: false
;enableVRIKKnucklesTrackPadSupport=false

; Managed by Configurator custom controller presets: independent Index pad halves.
; Bits 1/2 = left upper/lower; 4/8 = right upper/lower. Leave at 0 for legacy Menu/A.
; Do not change manually without the matching controlmapvr.txt assignments.
;indexTrackpadCustomRegions=0

; Default text pre-filled in the VR keyboard when it opens.
; Default: Adventurer
;keyboardText=Adventurer

; Allow unknown OpenVR properties without aborting.
; Default: false
;admitUnknownProps=false


; ----------------------------------------------------------------------------
;  DAPA — DEFAULT TUNING
; ----------------------------------------------------------------------------
; Enabling DAPA uses this baseline without further tuning. These are defaults,
; not overrides for existing saved values. Runtime motion smoothing/SSW should
; be off when testing DAPA. Frame timing and short pressure recovery are automatic.
; DAPA remains opt-in; set true to enable.
;aswEnabled=false
;aswWarpStrength=1.00
;aswRotationScale=1.00
;aswTranslationScale=0.00
;aswLocoScale=1.00
;aswDepthScale=1.00
;aswNearFadeDepth=0.00
;aswEdgeFadeWidth=3.00
; Manual mode: no optional FPS engagement threshold before DAPA can run.
;aswAutoNative=false
; Only used when aswAutoNative=true; adjusted for the runtime cadence.
;aswAutoEngageFps=50
; Pressure threshold scaled to runtime cadence; 12 ms is the 90 Hz reference.
;aswEndSpikeMs=12.00
; No synthetic-frame tint or developer visualizations by default.
;aswDebugMode=0


; ----------------------------------------------------------------------------
;  LOGGING  (for troubleshooting — leave off unless debugging)
; ----------------------------------------------------------------------------

; Logging detail. "normal" records startup, state changes, warnings, and errors.
; "debug" additionally records periodic frame and locomotion diagnostics.
; The log is reset at every game launch in either mode.
; Default: normal
;logLevel=normal

; Log all OpenVR API calls to the log file.
; Default: false
;logAllOpenVRCalls=false

; Log tracked device property queries.
; Default: false
;logGetTrackedProperty=false

; Stop execution on soft abort (for debugging).
; Default: false
;stopOnSoftAbort=false


; ============================================================================
;  VR KEYBOARD  —  Controller Shortcut & SendInput Mode
; ============================================================================
;
;  The VR keyboard includes a "CONSOLE" button that sends the tilde key (~)
;  to open/close the in-game console, and switches the keyboard to SendInput
;  mode where every key press is injected as a Windows keystroke.
;
;  You can also open a SendInput-only keyboard anywhere in the game using
;  a configurable controller shortcut (no text buffer — pure keystroke
;  injection). This is useful for console commands, mod menus, etc.
;
;  The keyboard includes arrow keys (LT, DN, UP, RT) and ESC for
;  navigating console history and closing menus.
;
;  To close the keyboard at any time, squeeze the grip button.
;
; ============================================================================

[keyboard]
# Auto loads OCUKeyboard.kb beside openvr_api.dll when a separate keyboard mod
# supplies it; otherwise OCU uses the embedded keyboard. Use embedded to ignore
# installed keyboard add-ons, or name a different .kb file explicitly.
layout=auto

; Enable the controller shortcut to open a SendInput keyboard anywhere.
; Default: true
;shortcutEnabled=true

; Which button activates the shortcut.
; Options:
;   left_stick   — press the left thumbstick
;   right_stick  — press the right thumbstick
;   a            — A button (right controller)
;   b            — B button (right controller)
;   both_grips   — squeeze both grip buttons simultaneously
; Default: left_stick
;shortcutButton=left_stick

; Activation mode for the shortcut button.
; Options:
;   double_tap   — press the button twice quickly
;   triple_tap   — press the button three times quickly
;   long_press   — hold the button down for the timing duration
; Default: double_tap
;shortcutMode=double_tap

; Timing in milliseconds:
;   For double_tap / triple_tap: maximum time between presses
;   For long_press: how long you must hold the button
; Default: 500
;shortcutTiming=500

; Index knuckles trackpad swipe to open the keyboard (either hand).
; Touch your thumb to the trackpad and slide most of the pad height
; within about half a second. Ignored on controllers without a trackpad.
; Options: none | swipe_up | swipe_down
; Default: none
;shortcutTrackpad=none
