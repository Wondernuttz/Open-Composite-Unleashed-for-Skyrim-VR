<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\Bluefox.ico</ApplicationIcon>
    <RootNamespace>OpenCompositeConfigurator</RootNamespace>
    <Nullable>enable</Nullable>
    <AssemblyName>OC Unleashed Configurator for Skyrim VR</AssemblyName>
    <Version>4.3.7-eye-editor-preview6</Version>
  </PropertyGroup>

  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\controllers.png" />
    <EmbeddedResource Include="Resources\knuckles.png" />
    <EmbeddedResource Include="Resources\psvr2_sense.png" />
    <EmbeddedResource Include="Resources\kofi.png" />
    <EmbeddedResource Include="Resources\Bluefox.png" />
    <EmbeddedResource Include="Resources\DragonPug.png" />
    <EmbeddedResource Include="Resources\FO4Fox.png" />
    <EmbeddedResource Include="controlmapvr_template.txt" />
    <EmbeddedResource Include="controlmapvr_vrsafe.txt" />
    <EmbeddedResource Include="controlmapvr_vrik.txt" />
    <EmbeddedResource Include="controlmapvr_oculus_optimized.txt" />
    <EmbeddedResource Include="controlmapvr_kvite.txt" />
    <EmbeddedResource Include="controlmapvr_snippy.txt" />
    <EmbeddedResource Include="controlmapvr_cangar.txt" />
    <EmbeddedResource Include="controlmapvr_cangar_spellsiphon.txt" />
    <EmbeddedResource Include="controlmapvr_peakcombat.txt" />
    <EmbeddedResource Include="controlmapvr_wondernutts.txt" />
    <EmbeddedResource Include="PotatoMode.wav" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\doc\OCU-Setup-Readme.html" Link="Docs\OCU-Setup-Readme.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\doc\Licenses\**\*.*" Link="Docs\Licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\doc\images\**\*.*" Link="Docs\images\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Body Tracking tab: camera capture (webcam + phone MJPEG streams).
         Pose inference is supplied by the bundled local MediaPipe runtime. -->
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hash-pinned MediaPipe Tasks v0.10.35 C runtime and Full pose model. -->
    <None Include="BodyTracking\README.txt" TargetPath="BodyTracking\README.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="BodyTracking\MediaPipe\v0.10.35\win-x64\libmediapipe.dll" TargetPath="libmediapipe.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="BodyTracking\MediaPipe\v0.10.35\win-x64\opencv_world3410.dll" TargetPath="opencv_world3410.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="BodyTracking\MediaPipe\v0.10.35\pose_landmarker_full.task" TargetPath="BodyTracking\MediaPipe\v0.10.35\pose_landmarker_full.task" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="BodyTracking\MediaPipe\v0.10.35\pose_landmarker_lite.task" TargetPath="BodyTracking\MediaPipe\v0.10.35\pose_landmarker_lite.task" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="BodyTracking\MediaPipe\v0.10.35\MEDIAPIPE-LICENSE.txt" TargetPath="BodyTracking\MediaPipe\v0.10.35\MEDIAPIPE-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="BodyTracking\MediaPipe\v0.10.35\OPENCV-LICENSE.txt" TargetPath="BodyTracking\MediaPipe\v0.10.35\OPENCV-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
